<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_module_action_log_view_list" model="ir.ui.view">
        <field name="name">ir.module.action.log.list</field>
        <field name="model">ir.module.action.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-danger="state == 'failed'" decoration-muted="state == 'running'">
                <field name="date_start" string="Date"/>
                <field name="operation"/>
                <field name="name" string="Modules"/>
                <field name="source"/>
                <field name="user_id"/>
                <field name="duration"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="ir_module_action_log_view_form" model="ir.ui.view">
        <field name="name">ir.module.action.log.form</field>
        <field name="model">ir.module.action.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="operation"/>
                            <field name="requested_modules"/>
                            <field name="source"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="duration"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="changes" string="Changes">
                            <field name="line_ids">
                                <list>
                                    <field name="module_name"/>
                                    <field name="change"/>
                                    <field name="version_before"/>
                                    <field name="version_after"/>
                                </list>
                            </field>
                        </page>
                        <page name="error" string="Error" invisible="not error">
                            <field name="error" class="font-monospace"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ir_module_action_log_view_search" model="ir.ui.view">
        <field name="name">ir.module.action.log.search</field>
        <field name="model">ir.module.action.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Modules" filter_domain="['|', ('requested_modules', 'ilike', self), ('line_ids.module_name', 'ilike', self)]"/>
                <field name="user_id"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="source_ui" string="User Interface" domain="[('source', '=', 'ui')]"/>
                <filter name="source_script" string="Command Line / Script" domain="[('source', '=', 'script')]"/>
                <filter name="source_server" string="Server Start" domain="[('source', '=', 'server')]"/>
                <group>
                    <filter name="group_operation" string="Operation" context="{'group_by': 'operation'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ir_module_action_log_action" model="ir.actions.act_window">
        <field name="name">Module History</field>
        <field name="res_model">ir.module.action.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No module operations recorded yet</p>
            <p>Installs, upgrades and uninstalls are recorded here, whether they come from
                the Apps screen, the command line or a server start with -i / -u.</p>
        </field>
    </record>

</odoo>
